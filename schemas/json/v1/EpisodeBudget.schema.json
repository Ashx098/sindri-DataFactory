    "wall_clock_limit_ms": {
      "minimum": 1,
      "title": "Wall Clock Limit Ms",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "limits",
    "wall_clock_limit_ms"
  ],
  "title": "EpisodeBudget",
  "type": "object"
}
